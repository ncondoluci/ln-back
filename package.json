{
  "name": "ln-back",
  "version": "1.0.0",
  "description": "Ejercicio Full Stack - Club La Nacion",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env ./dist/index.js",
    "build": "tsc && cpx \"src/utils/*.json\" dist/src/utils",
    "dev": "node --env-file=.env --watch --import=tsx ./src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "coveage": "jest --collect-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ncondoluci/ln-back.git"
  },
